{
  "$defs": {
    "BlockData": {
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "coordinate_system": {
          "anyOf": [
            {
              "const": "normalized_0_1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate System"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "block_type": {
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list",
            "table",
            "image",
            "equation",
            "caption",
            "header",
            "footer",
            "page_number",
            "footnote",
            "reference",
            "unknown"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "corrected_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Text"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "source_engine": {
          "title": "Source Engine",
          "type": "string"
        },
        "is_handwritten": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Handwritten"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "heading_level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Level"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SpanData"
          },
          "title": "Spans",
          "type": "array"
        },
        "raw_json": {
          "additionalProperties": true,
          "title": "Raw Json",
          "type": "object"
        }
      },
      "required": [
        "page_number",
        "block_type",
        "reading_order",
        "source_engine"
      ],
      "title": "BlockData",
      "type": "object"
    },
    "PageData": {
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text"
        },
        "rotation": {
          "anyOf": [
            {
              "enum": [
                0,
                90,
                180,
                270
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "PageData",
      "type": "object"
    },
    "SpanData": {
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "coordinate_system": {
          "anyOf": [
            {
              "const": "normalized_0_1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate System"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "span_type": {
          "title": "Span Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "raw_json": {
          "additionalProperties": true,
          "title": "Raw Json",
          "type": "object"
        }
      },
      "required": [
        "reading_order",
        "span_type"
      ],
      "title": "SpanData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageData"
      },
      "title": "Pages",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/BlockData"
      },
      "title": "Blocks",
      "type": "array"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "pages",
    "blocks",
    "source",
    "status"
  ],
  "title": "NormalizedDocument",
  "type": "object"
}
