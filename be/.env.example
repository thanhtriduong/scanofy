# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@ep-example.ap-southeast-1.aws.neon.tech/scanofy?sslmode=require&channel_binding=require
# Local fallback for quick smoke tests:
# DATABASE_URL=sqlite:///./scanofy_dev.db
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=50

# Object storage, planned after Week 1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# AI/OCR providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

MINERU_ENABLED=true
MINERU_COMMAND=mineru-kit
MINERU_OUTPUT_DIR=storage/mineru_outputs
MINERU_OCR_MODE=auto
MINERU_TIMEOUT_SECONDS=900
CHANDRA_ENABLED=true
VINTERN_ENABLED=false
